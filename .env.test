# Test-mode env: empty Supabase vars force isSupabaseConfigured=false in
# src/lib/supabase.js, so the app boots into demo mode (DEMO_USER pre-signed
# in, sample trips loaded from sampleData.js, no network calls).
# Used by `npm run dev:test` and the Playwright suite.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
